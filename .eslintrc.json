{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "globals": {
    "KATHAA": "readonly"
  },
  "rules": {
    "linebreak-style": ["error", "unix"],
    "semi": ["error", "always"],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ]
  },
  "overrides": [
    {
      "files": ["watch-deploy.js"],
      "env": {
        "node": true,
        "es2021": true
      },
      "parserOptions": {
        "sourceType": "script"
      },
      "globals": {
        "require": "readonly",
        "__dirname": "readonly",
        "module": "readonly",
        "process": "readonly"
      },
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
